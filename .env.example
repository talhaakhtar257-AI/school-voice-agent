NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RETELL_WEBHOOK_SECRET=
NEXT_PUBLIC_RETELL_AGENT_ID=
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
VOICE_MAX_CALL_SECONDS=
VOICE_MAX_CALLS_PER_VISITOR_PER_DAY=
VOICE_MONTHLY_CAP_MINUTES=
# Retell -> Settings -> API Keys. Server only: reads each call back from Retell.
RETELL_API_KEY=
# Retell -> a second public key for staff (live watch / take over). Server only.
RETELL_STAFF_PUBLIC_KEY=
# brevo.com -> SMTP & API -> API Keys. Summary emails; no domain needed (verify one sender address).
BREVO_API_KEY=
# resend.com -> API Keys. Used only if BREVO_API_KEY is empty; needs a verified domain.
RESEND_API_KEY=
# Sender: the address verified in Brevo, e.g. Al-Noor Admissions <school@gmail.com>
EMAIL_FROM=
# The school's admissions inbox that receives every enquiry summary.
SCHOOL_NOTIFY_EMAIL=
